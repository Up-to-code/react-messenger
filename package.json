  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.13.0"
}
