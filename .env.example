# Server-only settings. Never use NEXT_PUBLIC_ prefixes for keys.
# demo (default without configuration), openrouter, crewai, or openai
AGENT_BACKEND=demo

# Direct OpenRouter, or the model used by the CrewAI service.
# Set an exact model ID from your OpenRouter account, supporting tool calls.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# CrewAI service; same shared token here and in its server environment.
CREWAI_SERVICE_URL=http://127.0.0.1:8008
CREWAI_SERVICE_TOKEN=

# Optional legacy OpenAI Responses transport.
OPENAI_API_KEY=
OPENAI_MODEL=
